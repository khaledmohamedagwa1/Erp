# Template for ERP_HOME/.env. scripts/install.sh writes the real file (mode 0600); edit only the values marked OPTIONAL.
# Never put secrets here except SQL_SA_PASSWORD for the bundled SQL Server (the container reads it from the environment).
ERP_VERSION=0.0.0
# OPTIONAL: private registry prefix ending in "/" (empty for images loaded from the offline bundle).
ERP_REGISTRY=
# Public HTTPS origin users browse to (CORS + cookie scope), e.g. https://erp.customer.local
ERP_PUBLIC_ORIGIN=https://erp.example.local
ERP_HTTP_PORT=80
ERP_HTTPS_PORT=443
# Docker network for the stack; the API trusts X-Forwarded-* only from this range.
ERP_SUBNET=172.28.0.0/24
ERP_DATABASE=Erp
# true when the stack runs its own SQL Server container (profile bundled-sql).
ERP_BUNDLED_SQL=true
MSSQL_PID=Express
SQL_SA_PASSWORD=
# OPTIONAL resource limits
ERP_API_CPUS=2.0
ERP_API_MEMORY=2g
ERP_WORKER_CPUS=1.0
ERP_WORKER_MEMORY=1g
ERP_SQL_MEMORY=4g
ERP_LOG_LEVEL=Information
# OPTIONAL PDF output: start the stack with --profile pdf and set this to http://gotenberg:3000 (empty = HTML only).
ERP_PDF_GOTENBERG_URL=
# OPTIONAL backups (scripts/backup.sh)
ERP_BACKUP_RETENTION_DAYS=14
