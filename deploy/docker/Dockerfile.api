# syntax=docker/dockerfile:1
# Erp.Api — same image runs as api, worker or all (ERP__ROLE / Erp__Role).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/ ./
RUN dotnet restore src/Host/Erp.Api/Erp.Api.csproj
RUN dotnet publish src/Host/Erp.Api/Erp.Api.csproj -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true
COPY --from=build /app ./
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Erp.Api.dll"]
