# Copy to .env (never commit .env). All values below are placeholders for a developer machine.
SQL_SA_PASSWORD=<choose-a-strong-password>
# Random string used by the platform tenant-provisioning endpoint (>= 32 chars outside Development).
PLATFORM_API_KEY=
# PEM-encoded RSA private key for signing access tokens. Required when ASPNETCORE_ENVIRONMENT is not Development.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
AUTH_SIGNING_KEY_PEM=
ASPNETCORE_ENVIRONMENT=Development
AUTH_SECURE_COOKIES=false
# Dev-only convenience: apply migrations at API start (keep false anywhere real; use the migrator profile).
DATABASE_AUTOMIGRATE=false
CORS_ORIGIN=http://localhost:5173
API_PORT=8080
# OPTIONAL: start with --profile pdf and set to http://gotenberg:3000 to enable ?format=pdf
PDF_GOTENBERG_URL=
