{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Erp": {
    "Role": "all"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Auth": {
    "Issuer": "erp",
    "Audience": "erp-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SessionAbsoluteDays": 30,
    "SecureCookies": true
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalMilliseconds": 1000
  },
  "RateLimiting": {
    "AuthPerMinute": 20
  }
}
